rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function isListMember(listId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/grocery_lists/$(listId)).data.members;
    }

    match /grocery_lists/{listId} {
      allow read: if isListMember(listId);

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.householdId is string
        && isHouseholdMember(request.resource.data.householdId);

      allow update: if isListMember(listId)
        && resource.data.householdId == request.resource.data.householdId;
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /items/{itemId} {
        allow read: if isListMember(listId);
        allow create: if isListMember(listId)
          && request.resource.data.addedBy == request.auth.uid;
        allow update, delete: if isListMember(listId);
      }
    }

    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.inviteCode is string;

      allow update: if isHouseholdMember(householdId);
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /recipes/{recipeId} {
      allow read: if isSignedIn()
        && resource.data.householdId is string
        && isHouseholdMember(resource.data.householdId);

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.householdId is string
        && isHouseholdMember(request.resource.data.householdId);

      allow update, delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.householdId is string
        && isHouseholdMember(resource.data.householdId);
    }

    match /household_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.householdId is string
        && isHouseholdMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid;

      allow read: if isSignedIn()
        && resource.data.householdId is string
        && isHouseholdMember(resource.data.householdId);
    }

    match /stock/{stockId} {
      allow read: if isSignedIn()
        && resource.data.householdId is string
        && isHouseholdMember(resource.data.householdId);

      allow create: if isSignedIn()
        && request.resource.data.householdId is string
        && isHouseholdMember(request.resource.data.householdId)
        && request.resource.data.addedBy == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.householdId is string
        && request.resource.data.householdId == resource.data.householdId
        && isHouseholdMember(resource.data.householdId);

      allow delete: if isSignedIn()
        && resource.data.householdId is string
        && isHouseholdMember(resource.data.householdId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
