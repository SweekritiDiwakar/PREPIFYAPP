rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read any user profile, but only edit their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Anyone logged in can read recipes.
    // Only the creator can edit/delete their recipe.
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }
    
    // Grocery Lists
    match /groceryLists/{listId} {
      // Allow read/write if the user is a member of the list
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.members;
      // Allow create if the user is logged in
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      
      // Items subcollection within a list
      match /items/{itemId} {
        // We inherit the parent document (the grocery list), but in Firestore we normally 
        // have to fetch it with a get() to check parent fields, unless we only want basic auth check.
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groceryLists/$(listId)).data.members;
      }
    }
    
    // Pantry
    match /pantry/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null; // System/services can create
    }
    
    // Badges (Read-only for all users, only admin can create/edit)
    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if false; // Add custom admin condition if needed in future
    }
    
    // User Badges
    match /userBadges/{userBadgeId} {
      allow read: if request.auth != null; // Public stats
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Household Chat Messages
    match /messages/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderId
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;

      allow update, delete: if false;
    }
  }
}
